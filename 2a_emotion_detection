import requests
import json

def emotion_detector(text_to_analyze):
    if not text_to_analyze or text_to_analyze.strip() == "":
        # ✅ Manejo de entrada en blanco
        return {
            "anger": None,
            "disgust": None,
            "fear": None,
            "joy": None,
            "sadness": None,
            "status_code": 400
        }

    # Ajusta con tu URL real de Watson NLP
    url = "https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/TU_INSTANCIA/v1/analyze"
    headers = {"Content-Type": "application/json"}
    payload = json.dumps({
        "text": text_to_analyze,
        "features": {
            "emotion": {}
        }
    })

    # Autenticación con tu API Key
    response = requests.post(url, headers=headers, data=payload, auth=('apikey', 'TU_API_KEY'))

    if response.status_code == 200:
        emotions = response.json()["emotion"]["document"]["emotion"]
        return {
            "anger": emotions["anger"],
            "disgust": emotions["disgust"],
            "fear": emotions["fear"],
            "joy": emotions["joy"],
            "sadness": emotions["sadness"],
            "status_code": 200
        }
    elif response.status_code == 400:
        # ✅ Caso explícito de error 400
        return {
            "anger": None,
            "disgust": None,
            "fear": None,
            "joy": None,
            "sadness": None,
            "status_code": 400
        }
    else:
        return {"error": f"Error en la solicitud: {response.status_code}", "status_code": response.status_code}
